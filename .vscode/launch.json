{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 HRPC/LLECP",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/local/bin/HRPC/LLECP",
            "args": ["enp2s0"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "编译 LLECP",
            "setupCommands": [
                {
                    "description": "启用 GDB 格式化显示",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}