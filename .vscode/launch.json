{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 LL_Controller",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/local/bin/LLECT/LL_Controller",
      "args": [
        "/usr/local/bin/LLECT/runtime"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "编译 LL_Controller",
      "externalConsole": false,
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "调试 LL_CPS (Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/local/bin/LLECT/LL_CPS",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "编译 LL_CPS",
      "externalConsole": false
    },
    {
      "name": "调试 LL_CPS (Windows / Visual Studio)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-vs/bin/DEBUG/LL_CPS.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build/windows-vs/bin/DEBUG",
      "preLaunchTask": "编译 LL_CPS",
      "console": "internalConsole"
    }
  ]
}
