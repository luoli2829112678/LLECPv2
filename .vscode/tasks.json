{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "配置 LLECP",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "/usr/local/bin/LLECT/build/linux",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DLLECP_OUTPUT_DIRECTORY=/usr/local/bin/LLECT",
        "-DLLECP_BUILD_CONTROLLER=ON",
        "-DLLECP_BUILD_CPS=OFF",
        "-DBUILD_TESTING=ON"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/LL_CPS/GenerateVisualStudio.ps1"
        ]
      }
    },
    {
      "label": "编译全部",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "/usr/local/bin/LLECT/build/linux",
        "--target",
        "LL_Controller",
        "--parallel"
      ],
      "dependsOn": "配置 LLECP",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build/windows-vs",
          "--config",
          "Debug",
          "--parallel"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "detail": "Linux 服务器编译控制器；Windows 编译 CPS。"
    },
    {
      "label": "编译 LL_Controller",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "/usr/local/bin/LLECT/build/linux",
        "--target",
        "LL_Controller",
        "--parallel"
      ],
      "dependsOn": "配置 LLECP",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "编译 LL_CPS",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "/usr/local/bin/LLECT/build/linux-cps",
        "--target",
        "LL_CPS",
        "--parallel"
      ],
      "dependsOn": "配置 CPS",
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build/windows-vs",
          "--config",
          "Debug",
          "--parallel"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      }
    },
    {
      "label": "配置测试",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "/usr/local/bin/LLECT/build/linux",
        "-DBUILD_TESTING=ON",
        "-DLLECP_OUTPUT_DIRECTORY=/usr/local/bin/LLECT",
        "-DLLECP_BUILD_CONTROLLER=ON",
        "-DLLECP_BUILD_CPS=OFF"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/LL_CPS/GenerateVisualStudio.ps1"
        ]
      }
    },
    {
      "label": "编译测试",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "/usr/local/bin/LLECT/build/linux",
        "--target",
        "master_tests",
        "protocol_registry_tests",
        "controller_network_tests",
        "cps_network_tests",
        "--parallel"
      ],
      "dependsOn": "配置测试",
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build/windows-vs",
          "--config",
          "Debug",
          "--parallel"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      }
    },
    {
      "label": "测试 LLECP",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "/usr/local/bin/LLECT/build/linux",
        "--output-on-failure"
      ],
      "dependsOn": "编译测试",
      "problemMatcher": [],
      "windows": {
        "command": "ctest",
        "args": [
          "--test-dir",
          "${workspaceFolder}/build/windows-vs",
          "-C",
          "Debug",
          "--output-on-failure"
        ]
      }
    },
    {
      "label": "配置 CPS",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "/usr/local/bin/LLECT/build/linux-cps",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DLLECP_OUTPUT_DIRECTORY=/usr/local/bin/LLECT",
        "-DLLECP_BUILD_CONTROLLER=OFF",
        "-DLLECP_BUILD_CPS=ON",
        "-DBUILD_TESTING=ON"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/LL_CPS/GenerateVisualStudio.ps1"
        ]
      }
    }
  ]
}
